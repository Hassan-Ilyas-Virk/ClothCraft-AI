# MongoDB connection settings
# For local MongoDB instance (works with MongoDB Compass)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=clothcraft_ai

# Set true to fail startup if DB is unavailable
MONGODB_REQUIRED=false

# Initial server selection timeout for Mongo client
MONGODB_CONNECT_TIMEOUT_MS=5000

# Allowed frontend origins for credentialed CORS requests
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT/session cookie settings
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
AUTH_COOKIE_NAME=cc_auth

# Set true when serving over HTTPS
AUTH_COOKIE_SECURE=false
